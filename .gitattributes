# 换行与二进制处理规则

# 默认：自动识别文本并统一按 LF 入库，二进制文件原样保存。
* text=auto

# Windows 批处理必须保留 CRLF，否则 cmd.exe 解析 goto/label 会出错。
*.cmd text eol=crlf
*.bat text eol=crlf

# 明确的二进制类型，禁止做任何换行转换。
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.m4a binary
*.zip binary
*.7z binary
*.pdf binary
*.pyd binary
*.dll binary
*.exe binary

# 生成物不参与语言统计，避免仓库指标被资产噪音淹没。
mj-automation/output/** linguist-generated=true
mj-automation/archive/** linguist-generated=true
