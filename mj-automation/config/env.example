# MJ 自动化 —— 环境变量样例
#
# 用法（PowerShell，当前窗口生效）：
#   Get-Content E:\codex\multica\mj-automation\config\env.example |
#     Where-Object { $_ -match '^[A-Z]' } |
#     ForEach-Object { $kv = $_ -split '=',2; Set-Item -Path ("env:" + $kv[0]) -Value $kv[1] }
#
# 或者只挑需要改的几行手动设置。下面每一项都写了默认值与是否必须。
# 红线：本文件只放路径与开关，不放任何账号密码、token、cookie。

# ---------------------------------------------------------------- 必设项

# 浏览器登录态目录。默认值指向脚本所在目录，那里没有登录态，必须改成下面这个。
# 该目录来自原项目，登录态已验证有效（.login_probe.txt = isLoggedIn = true）。
MXAI_PROFILE=E:\codex\niannianai\zhuanhuiyuangong\ai-rpa-console\.browser-profile

# 生图页地址（中文版 MXAI，含邀请参数，保持原样）。
MXAI_URL=https://www.mxai.cn/home/?mp=mjdrawai&from=invite&invite_id=100595351#/mj

# 适配器位置。默认就是本目录的改造副本，一般不用改。
MXAI_ADAPTER_PATH=E:\codex\multica\mj-automation\scripts\mxai_adapter.js

# playwright 所在目录。原项目已装好 playwright 1.62.1，这里复用，不重复安装。
MXAI_NODE_MODULES=E:\codex\niannianai\zhuanhuiyuangong\ai-rpa-console\node_modules

# ---------------------------------------------------------------- 产物与台账

# 高清原图落盘目录。
MJ_OUTPUT_DIR=E:\codex\multica\mj-automation\output

# 回执台账目录（每条真实出图追加一行 JSON）。
MJ_RECEIPTS_DIR=E:\codex\multica\mj-automation\receipts

# 归档目录（人工验收通过后的成品放这里）。
MJ_ARCHIVE_DIR=E:\codex\multica\mj-automation\archive

# ---------------------------------------------------------------- 校验阈值

# 内容校验下限。低于这两个值的文件会被判定为占位图/错误页并拦下。
# 实测拦下的垃圾：loading 占位 GIF 140077 字节 / 400x257、HTML 错误页 1080~1515 字节。
# 合格高清母图实测 5.6–9.3MB / 1792x2688（四宫格整图 1856x2464）。
# 这两个默认值与 verify_result.js 内部默认值保持一致（200KB / 1024），不要单方面调低。
MJ_MIN_BYTES=200000
MJ_MIN_DIM=1024

# ---------------------------------------------------------------- 服务参数

# FastAPI 监听端口。
MJ_BRIDGE_PORT=8765

# 对外暴露的模型名（画布渠道里填这个）。
MJ_BRIDGE_MODEL=midjourney

# 默认 MJ 版本。
MJ_BRIDGE_VERSION=v8.2

# 单张生成超时（毫秒）。MJ 本机队列实测约 11 分钟，加下载约 12–13 分钟，
# 因此默认给到 900000（15 分钟）。不要调回 300000，否则队列高峰期会被
# subprocess 超时掐断，出现"其实已出图、本地却记成失败"的假失败。
MJ_BRIDGE_TIMEOUT_MS=900000

# 单次请求最多允许几张（n 的上限）。
MJ_BRIDGE_MAX_N=15

# ---------------------------------------------------------------- 运行开关

# 是否无头运行。默认 false：需要真实桌面窗口，登录/验证码/风控都要看得见。
MXAI_HEADLESS=false

# 代理地址。MXAI 联网前置条件，代理不在线会导致页面一直卡在加载。
MXAI_PROXY=127.0.0.1:7897
